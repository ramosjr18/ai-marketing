# Copy to .env and fill in. .env is gitignored; this file is not.
# Written by /set-engine and /set-mail — you can also fill it by hand.

# --- outreach engine (/set-engine) ---
COLD_CLI_BIN=                 # path to the cold-cli binary, usually ~/.local/bin/cold-cli
COLD_CLI_COMMIT=68a6defb29cc  # pinned commit; cold-cli publishes no tags or releases
COLD_CLI_STORAGE=sqlite       # sqlite | postgres
COLD_CLI_DATABASE_URL=        # only when COLD_CLI_STORAGE=postgres; direct connection, no pooler

# --- mail servers: defaults every mailbox inherits (/set-mail) ---
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465            # 465 with ssl, or 587 with starttls
MAIL_SMTP_SECURITY=ssl        # ssl | starttls
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_TEST_TO=                 # where test sends go. Never a prospect

# --- mailboxes: one block per slug, matching the person in 03-people.md ---
# A mailbox on another provider overrides what it needs:
#   MAILBOX_<SLUG>_SMTP_HOST=…  MAILBOX_<SLUG>_IMAP_HOST=…  MAILBOX_<SLUG>_SMTP_PORT=…
MAILBOX_SLUGS=                # comma-separated, e.g. alex,sam

MAILBOX_ALEX_USER=
MAILBOX_ALEX_PASSWORD=        # application password when the provider offers one

# --- canal LinkedIn (tools/linkedin.py, plan 10) ---
# Chromium lo arranca la persona: chromium --remote-debugging-port=9222
# No hay credenciales de LinkedIn aquí ni en ningún otro sitio del repo.
LINKEDIN_CDP_URL=http://127.0.0.1:9222
